/**
 * AgencyOS – Cloudflare Worker configuration.
 * Replace the placeholder IDs below after running the `wrangler hyperdrive create` /
 * `wrangler kv namespace create` commands described in the README. Local development works with the
 * placeholders as-is.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agencyos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The app's own domain. Cloudflare creates the DNS records and certificates for these on deploy.
  "routes": [
    { "pattern": "growupliftos.com", "custom_domain": true },
    { "pattern": "www.growupliftos.com", "custom_domain": true }
  ],
  // Keep the original workers.dev address working too (declaring routes would otherwise switch it
  // off): links already shared with clients point at it.
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    // Every non-asset, non-API path falls back to index.html so React Router can handle it.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is served straight from the edge cache.
    "run_worker_first": ["/api/*"]
  },
  // Postgres lives on Supabase. Hyperdrive is Cloudflare's connection pooler for it: create one with
  // `wrangler hyperdrive create` (see README) and paste its id here.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "428aa5bfd6a341bb9caffdc666f743c6",
      // Local development connects straight to this database instead (default: the Supabase CLI's
      // local Postgres). Override it by setting DATABASE_URL in .env.
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "agencyos-uploads"
    }
  ],
  // Reserved for edge caching in later phases. (Rate limiting moved to the native binding below:
  // a KV counter costs one write per request, and the free plan allows only ~1,000 writes a day.)
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3147ad97b7da4216b9fef5927a22ae4c"
    }
  ],
  // Cloudflare's built-in rate limiter: counted at the edge, per key, no storage writes and no cost.
  // `namespace_id` is any unique number you choose; `period` must be 10 or 60 seconds.
  "ratelimits": [
    // Sign-in and session endpoints, per IP.
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    // Public, unauthenticated routes (logos now; invoice / contract / portal links later), per IP.
    { "name": "PUBLIC_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  // Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET) are NOT listed here: they are set
  // on the deployed Worker (dashboard → Settings → Variables and Secrets, or `wrangler secret put`)
  // and in .dev.vars locally. Their types are declared in worker/env.d.ts. Until they are set the app
  // still deploys and serves pages, but sign-in reports "not configured".
  "vars": {
    // Optional: set to your canonical origin (e.g. "https://app.example.com") to pin OAuth redirects
    // and public share links to one domain. When empty, the request origin is used.
    "APP_URL": ""
  },
  "observability": {
    "enabled": true
  }
}
