# Copy to .env (never commit .env). Read by drizzle-kit, the seed script and `npm run dev`.

# Local Postgres for development. The default below is the Supabase CLI's local database
# (`npx supabase start`); any Postgres 15+ works.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Your Supabase project, used ONLY by `npm run db:migrate:remote`.
# Supabase dashboard → Connect → "Session pooler" (port 5432). URL-encode special characters in the password.
DATABASE_URL_REMOTE=
